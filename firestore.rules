rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Um "household" (lar financeiro) é compartilhado entre os e-mails
    // listados no campo `members`. Só quem está na lista lê e escreve.
    match /households/{hid} {

      function isMember() {
        return request.auth != null
          && request.auth.token.email in resource.data.members;
      }

      // criar um household novo: precisa se incluir como membro e dono
      allow create: if request.auth != null
        && request.auth.token.email in request.resource.data.members
        && request.resource.data.owner == request.auth.token.email;

      // ler / listar: apenas membros
      allow read: if isMember();

      // atualizar (ex.: convidar membro): apenas membros,
      // e o dono nunca pode ser removido da lista
      allow update: if isMember()
        && resource.data.owner in request.resource.data.members
        && request.resource.data.owner == resource.data.owner;

      allow delete: if request.auth != null
        && request.auth.token.email == resource.data.owner;

      // subcoleções (transações, dívidas, investimentos, configurações)
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.token.email in
             get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }

    // tudo o mais: negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
